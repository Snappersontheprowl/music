#!/bin/sh
set -eu
project_root=$(git rev-parse --show-toplevel)
if [ ! -x "$project_root/.venv/bin/python" ]; then
    echo 'Push blocked: create the project .venv before running the history check.' >&2
    exit 1
fi
exec "$project_root/.venv/bin/python" "$project_root/scripts/check_public_history.py" --pre-push "$@"
